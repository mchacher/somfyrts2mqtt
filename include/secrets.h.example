/**
 * @file secrets.h.example
 * @brief Template for include/secrets.h.
 *
 * Copy this file to include/secrets.h and fill in real values (or leave
 * them empty to commission the box via the captive portal at first boot).
 * include/secrets.h is gitignored and must NEVER be committed.
 *
 * --- WiFi (iter 015) ---
 * Empty defaults : a fresh box with no NVS creds boots straight into the
 * captive portal AP (SSID `somfyrts2mqtt-XXXXXX`) for the user to enter
 * SSID + password from any phone. The values defined here are used ONLY
 * as a one-shot migration to NVS the very first time the firmware runs
 * on a box that has these constants set non-empty -- useful for skipping
 * the AP dance during local development.
 *
 * --- MQTT ---
 * Broker values seed NVS on the first boot only ; afterwards the web UI
 * is the canonical place to edit the config.
 */
#pragma once

#define WIFI_SSID     ""
#define WIFI_PASSWORD ""

#define MQTT_BROKER_HOST "192.168.0.230"
#define MQTT_BROKER_PORT 1883
#define MQTT_BROKER_USER ""
#define MQTT_BROKER_PASS ""

/**
 * --- ArduinoOTA password (iter 016, dev workflow only) ---
 *
 * Protects the espota.py push from PlatformIO. End users never need
 * ArduinoOTA -- the captive-portal-commissioned bridge updates via
 * WebOTA (admin UI upload + GitHub Releases). Change this if you
 * develop on a shared network.
 */
#define OTA_PASSWORD "somfy"
