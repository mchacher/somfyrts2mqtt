/**
 * @file secrets.h.example
 * @brief Template for include/secrets.h.
 *
 * Copy this file to include/secrets.h and fill in real values.
 * include/secrets.h is gitignored and must NEVER be committed.
 *
 * WiFi credentials are read at every boot.
 * MQTT broker values seed NVS on the first boot only; afterwards the
 * runtime config (NVS, future web UI in iter 007) takes precedence.
 */
#pragma once

#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

#define MQTT_BROKER_HOST "192.168.0.230"
#define MQTT_BROKER_PORT 1883
#define MQTT_BROKER_USER ""
#define MQTT_BROKER_PASS ""
